@echo off
setlocal DisableDelayedExpansion
rem TaskbarMatch 1.1.2 beta - Windows 11 x64. Double-click to start; run again to stop.
rem Source and GPL license are embedded below. No administrator request.
set "TASKBARMATCH_SELF=%~f0"
set "TASKBARMATCH_PS=%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe"
if exist "%SystemRoot%\Sysnative\WindowsPowerShell\v1.0\powershell.exe" set "TASKBARMATCH_PS=%SystemRoot%\Sysnative\WindowsPowerShell\v1.0\powershell.exe"
"%TASKBARMATCH_PS%" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -Command "$ErrorActionPreference='Stop'; try { $text=[IO.File]::ReadAllText($env:TASKBARMATCH_SELF); $part=[regex]::Match($text,'(?ms)^#<POWERSHELL>\r?\n(.*?)^#</POWERSHELL>'); if(-not $part.Success){throw 'The TaskbarMatch launch file is incomplete.'}; & ([scriptblock]::Create($part.Groups[1].Value)); } catch { Add-Type -AssemblyName System.Windows.Forms; [System.Windows.Forms.MessageBox]::Show($_.Exception.Message,'TaskbarMatch could not start') | Out-Null }"
exit /b

#<POWERSHELL>
$ErrorActionPreference = 'Stop'
Set-StrictMode -Version 2
Add-Type -AssemblyName System.Windows.Forms

# TaskbarMatch, Windows 11 x64. This launcher uses only Windows components.
# The runtime source appears below in this same file. No global execution-policy
# or Windows theme/accent settings are modified.
$root = Join-Path $env:LOCALAPPDATA 'TaskbarMatch'
$setupLock = $null
$locked = $false
$notice = $null
try {
    $sid = [Security.Principal.WindowsIdentity]::GetCurrent().User.Value
    $stopName = 'Local\TaskbarMatch.Stop.' + $sid
    try {
        $stopEvent = [Threading.EventWaitHandle]::OpenExisting($stopName)
        [void]$stopEvent.Set()
        $stopEvent.Dispose()
        return
    } catch [Threading.WaitHandleCannotBeOpenedException] { }

    if (-not [Environment]::Is64BitProcess -or $env:PROCESSOR_ARCHITECTURE -ne 'AMD64') {
        throw 'This file targets x64 Windows 11, not ARM64 or 32-bit Windows.'
    }
    $os = Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion'
    if ([int]$os.CurrentBuildNumber -lt 22621) {
        throw 'TaskbarMatch requires the modern Windows 11 taskbar (build 22621 or later).'
    }
    $setupLock = [Threading.Mutex]::new($false, ('Local\TaskbarMatch.Setup.' + $sid))
    try { $locked = $setupLock.WaitOne(0) } catch [Threading.AbandonedMutexException] { $locked = $true }
    if (-not $locked) { return }
    [void][IO.Directory]::CreateDirectory($root)

    $whole = [IO.File]::ReadAllText($env:TASKBARMATCH_SELF)
    $match = [regex]::Match($whole, '(?ms)^#<CSHARP>\r?\n(.*?)^#</CSHARP>')
    if (-not $match.Success) { throw 'The C# source is missing. The downloaded file is incomplete.' }
    $source = $match.Groups[1].Value
    $license = [regex]::Match($whole, '(?ms)^#<LICENSE>\r?\n(.*?)^#</LICENSE>')
    if ($license.Success) { [IO.File]::WriteAllText((Join-Path $root 'LICENSE.txt'), $license.Groups[1].Value) }
    $sha = [Security.Cryptography.SHA256]::Create()
    try {
        $sourceHash = ([BitConverter]::ToString($sha.ComputeHash([Text.Encoding]::UTF8.GetBytes($source)))).Replace('-', '').ToLowerInvariant()
    } finally { $sha.Dispose() }

    $appDir = Join-Path $root ('app-' + $sourceHash.Substring(0, 16))
    $exe = Join-Path $appDir 'TaskbarMatch.exe'
    $depDir = Join-Path $root 'xaml-1.1.2-b1-1ca10b294157'
    $dll = Join-Path $depDir 'TaskbarMatch.Xaml.dll'
    $expected = '1ca10b294157a0bd814e33b3888f72dc13d4c1401bbce947cc2c619972c47f62'
    $helperReady = (Test-Path -LiteralPath $dll) -and ((Get-FileHash -LiteralPath $dll -Algorithm SHA256).Hash -eq $expected)
    if (-not $helperReady -or -not (Test-Path -LiteralPath $exe)) {
        $notice = New-Object System.Windows.Forms.NotifyIcon
        $notice.Icon = [Drawing.SystemIcons]::Information
        $notice.Text = 'TaskbarMatch: preparing natural-hover update'
        $notice.Visible = $true
        $notice.ShowBalloonTip(6000, 'TaskbarMatch 1.1.2', 'Preparing the updated taskbar helper and compiling the local runtime.', [Windows.Forms.ToolTipIcon]::Info)
        [Windows.Forms.Application]::DoEvents()
    }
    if (-not $helperReady) {
